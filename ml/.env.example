# Copy to .env for machine-local, non-secret development settings.
# Never commit real credentials or secrets.
IOTGUARD_ENV=development
IOTGUARD_LOG_LEVEL=INFO

# Read-only source roots for the A0/A1 dataset inventory.
IOTGUARD_NBAIOT_ROOT=E:/path/to/N_BaIoT_Dataset
IOTGUARD_BOTIOT_ROOT=E:/path/to/Bot_IoT_Dataset
IOTGUARD_DATASET_WORK_ROOT=E:/path/to/iotguard_dataset_work
