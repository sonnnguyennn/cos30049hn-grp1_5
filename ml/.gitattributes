* text=auto
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.parquet binary
*.joblib binary
